# Shell launchers must keep LF endings, or sh fails on Windows checkouts with core.autocrlf=true.
plugin/scripts/te text eol=lf
plugin/scripts/te-hook text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
# gh-aw compiles each .github/workflows/*.md into this generated file; keep it out of diffs.
.github/workflows/*.lock.yml linguist-generated=true
