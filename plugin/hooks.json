{
  "tokeneconomizer": {
    "SessionStart": [
      { "type": "command", "command": "scripts\\te-hook.cmd --host antigravity --event SessionStart 2>nul || ./scripts/te-hook --host antigravity --event SessionStart", "timeout": 15 }
    ],
    "PreInvocation": [
      { "type": "command", "command": "scripts\\te-hook.cmd --host antigravity --event PreInvocation 2>nul || ./scripts/te-hook --host antigravity --event PreInvocation", "timeout": 10 }
