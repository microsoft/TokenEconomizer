{
  "description": "TokenEconomizer on the GitHub Copilot CLI: inject learned repo facts at session start, guard prompt-turns against failing loops, and fold each finished session into what is learned.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/te-hook\" --host copilot",
            "windows": "& (Join-Path $env:CLAUDE_PLUGIN_ROOT 'scripts\\te-hook.ps1') --host copilot",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/te-hook\" --host copilot",
            "windows": "& (Join-Path $env:CLAUDE_PLUGIN_ROOT 'scripts\\te-hook.ps1') --host copilot",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/te-hook\" --host copilot",
            "windows": "& (Join-Path $env:CLAUDE_PLUGIN_ROOT 'scripts\\te-hook.ps1') --host copilot",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/te-hook\" --host copilot",
            "windows": "& (Join-Path $env:CLAUDE_PLUGIN_ROOT 'scripts\\te-hook.ps1') --host copilot",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/te-hook\" --host copilot",
            "windows": "& (Join-Path $env:CLAUDE_PLUGIN_ROOT 'scripts\\te-hook.ps1') --host copilot",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/te-hook\" --host copilot",
            "windows": "& (Join-Path $env:CLAUDE_PLUGIN_ROOT 'scripts\\te-hook.ps1') --host copilot",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
