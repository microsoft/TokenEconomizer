#!/bin/sh
# TokenEconomizer hook launcher: run the hook dispatcher under the first Python 3 on PATH.
# Fails open -- with no usable Python the hook prints an empty object, which changes nothing.
# On Windows (Git Bash), $0 can arrive with backslashes, and `python3` can be an App Execution
# Alias under WindowsApps. The Microsoft Store's runs nothing, and every launch of the Python
# Install Manager's starts an update check whose memory AppXSvc never frees (python/pymanager#396),
# which a hook would do on every tool call. So `TE_PYTHON` is taken as it is, python3, python and
# the `py` launcher come from PATH outside WindowsApps first, and an alias is the last resort,
# tried before use.
self=$0
if [ "${OS:-}" = Windows_NT ]; then
  case $self in *\\*) self=$(printf '%s' "$self" | tr '\\' '/') ;; esac
fi
dir=$(CDPATH= cd -- "${self%/*}" && pwd)
# Session logs are UTF-8; without this, Python on Windows reads them in the ANSI code page.
export PYTHONUTF8=1
# The first `$1` in a PATH directory outside WindowsApps.
outside_windowsapps() (
  IFS=:; set -f
  for d in $PATH; do
    case $d in ''|*WindowsApps*) continue ;; esac
    [ -f "$d/$1" ] && [ -x "$d/$1" ] && printf '%s\n' "$d/$1" && exit 0
  done
  exit 1
)
p=
if [ "${OS:-}" = Windows_NT ]; then
  for py in "${TE_PYTHON:-}" python3 python py; do
    [ -n "$py" ] && p=$(command -v "$py") || continue
    case $p in
      *WindowsApps*) if [ "$py" = "${TE_PYTHON:-}" ]; then
                       "$p" -c "" </dev/null >/dev/null 2>&1 && break
                     else
                       p=$(outside_windowsapps "$py") && break
                     fi ;;
      *) break ;;
    esac
    p=
  done
  [ -n "$p" ] || for py in python3 python py; do
    p=$(command -v "$py") && "$p" -c "" </dev/null >/dev/null 2>&1 && break
    p=
  done
else
  for py in "${TE_PYTHON:-}" python3 python; do   # `py` is Python's launcher only on Windows
    [ -n "$py" ] && command -v "$py" >/dev/null 2>&1 && p=$py && break
  done
fi
if [ -n "$p" ]; then
  [ "$py" = py ] && exec "$p" -3 "$dir/te_bootstrap.py" hook "$@"
  exec "$p" "$dir/te_bootstrap.py" hook "$@"
fi
# Drain stdin with a builtin (no `cat` when PATH is empty), then answer "no change".
while IFS= read -r _line; do :; done
echo '{}'
