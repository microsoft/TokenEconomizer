#!/bin/sh
# TokenEconomizer hook launcher: run the hook dispatcher under TE_PYTHON, else the first Python
# 3.10+ on PATH.
# Fails open -- with no usable Python the hook prints an empty object, which changes nothing.
# On Windows (Git Bash), $0 can arrive with backslashes. The Microsoft Store alias under WindowsApps
# runs nothing, and every probe of it starts AppXSvc (python/pymanager#396), so a Python outside
# WindowsApps is tried first and the alias is probed only as a last resort; `py` is the final candidate.
self=$0
if [ "${OS:-}" = Windows_NT ]; then
  case $self in *\\*) self=$(printf '%s' "$self" | tr '\\' '/') ;; esac
fi
dir=$(CDPATH= cd -- "${self%/*}" && pwd)
# Session logs are UTF-8; without this, Python on Windows reads them in the ANSI code page.
export PYTHONUTF8=1
outside_windowsapps() {
  set -f; _ifs=$IFS; IFS=:
  for _d in $PATH; do
    case $_d in ''|*WindowsApps*) continue ;; esac
    for _f in "$_d/$1.exe" "$_d/$1"; do
      if [ -f "$_f" ] && [ -x "$_f" ]; then IFS=$_ifs; set +f; printf '%s\n' "$_f"; return 0; fi
    done
  done
  IFS=$_ifs; set +f; return 1
}
if [ "${OS:-}" = Windows_NT ]; then
  for py in "${TE_PYTHON:-}" python3 python py; do
    [ -n "$py" ] && p=$(command -v "$py" 2>/dev/null) || continue
    case $p in *WindowsApps*) p=$(outside_windowsapps "$py") || continue ;; esac
    [ "$py" = py ] && exec "$p" -3 "$dir/te_bootstrap.py" hook "$@"
    exec "$p" "$dir/te_bootstrap.py" hook "$@"
  done
  for py in "${TE_PYTHON:-}" python3 python py; do
    [ -n "$py" ] && command -v "$py" >/dev/null 2>&1 || continue
    "$py" -c "" </dev/null >/dev/null 2>&1 || continue
    [ "$py" = py ] && exec py -3 "$dir/te_bootstrap.py" hook "$@"
    exec "$py" "$dir/te_bootstrap.py" hook "$@"
  done
else
  # TE_PYTHON is the person's own choice: it runs as named. Otherwise the first python3 on PATH
  # can be older than the bootstrap's minimum (macOS /usr/bin/python3 is 3.9, and an agent's
  # hook PATH is often not a login shell's), which would make the plugin a silent no-op with a
  # newer Python installed: take the first one new enough. With none, run the first one too old
  # (the probe exits 1), so the bootstrap still fails open / says what it needs; a name that
  # runs no Python (a pyenv shim with no version set exits 127) is passed over. The probe
  # skips `site` (-E -S).
  if [ -n "${TE_PYTHON:-}" ] && command -v "$TE_PYTHON" >/dev/null 2>&1; then
    exec "$TE_PYTHON" "$dir/te_bootstrap.py" hook "$@"
  fi
  probe='import sys; sys.exit(sys.version_info < (3, 10))'
  old=
  for py in python3 python3.15 python3.14 python3.13 python3.12 python3.11 python3.10 python; do
    command -v "$py" >/dev/null 2>&1 || continue
    "$py" -E -S -c "$probe" </dev/null >/dev/null 2>&1
    case $? in
      0) exec "$py" "$dir/te_bootstrap.py" hook "$@" ;;
      1) [ -n "$old" ] || old=$py ;;
    esac
  done
  [ -n "$old" ] && exec "$old" "$dir/te_bootstrap.py" hook "$@"
fi
# Drain stdin with a builtin (no `cat` when PATH is empty), then answer "no change".
while IFS= read -r _line; do :; done
echo '{}'
